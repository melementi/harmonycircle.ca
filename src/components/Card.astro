---
import Ring from "./Ring.astro";

/**
 * Outlined card. On hover the border traces itself in accent, four staggered
 * scale animations rather than a colour swap, which is the reference site's
 * `trace-*` keyframes rebuilt.
 *
 * `href` makes the whole card a link and puts the anchor on the title, so the
 * accessible name is the title rather than "card" — the stretched-link pattern,
 * not a div with a click handler.
 */
export interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  meta?: string;
  onInk?: boolean;
  class?: string;
}

const { title, eyebrow, href, meta, onInk = false, class: className = "" } = Astro.props;

const border = onInk ? "border-paper/15" : "border-ink/15";
const titleTone = onInk ? "text-paper" : "text-ink";
const bodyTone = onInk ? "text-paper/80" : "text-ink/80";
const metaTone = onInk ? "text-paper/60" : "text-ink/70";
---

<article
  class:list={[
    "group relative flex flex-col gap-4 border p-6 md:p-8",
    border,
    "transition-colors duration-300",
    className,
  ]}
>
  {/* Border trace. Purely decorative, staggered so it reads as a line being
      drawn rather than four edges appearing. */}
  <span aria-hidden="true" class="pointer-events-none absolute inset-0">
    <span class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100"></span>
    <span class="absolute inset-y-0 right-0 w-px origin-top scale-y-0 bg-accent transition-transform delay-100 duration-300 group-hover:scale-y-100"></span>
    <span class="absolute inset-x-0 bottom-0 h-px origin-right scale-x-0 bg-accent transition-transform delay-200 duration-300 group-hover:scale-x-100"></span>
    <span class="absolute inset-y-0 left-0 w-px origin-bottom scale-y-0 bg-accent transition-transform delay-300 duration-300 group-hover:scale-y-100"></span>
  </span>

  {
    eyebrow && (
      <p class:list={["label flex items-center gap-2", metaTone]}>
        <Ring size="xs" variant="outline" tone={onInk ? "paper" : "accent"} />
        {eyebrow}
      </p>
    )
  }

  <h3 class:list={["display-3", titleTone]}>
    {
      href ? (
        <a href={href} class="after:absolute after:inset-0 after:content-['']">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>

  <div class:list={["text-base leading-relaxed", bodyTone]}>
    <slot />
  </div>

  {meta && <p class:list={["label mt-auto", metaTone]}>{meta}</p>}
</article>
