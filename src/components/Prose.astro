---
/**
 * Long-form body styling for content-collection output. No typography plugin —
 * the system has two type registers and a body treatment, and a plugin would
 * introduce a third set of sizes nobody chose.
 */
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-6 text-base leading-relaxed text-ink/80 md:text-lg",
    "[&_h2]:mt-6 [&_h2]:font-black [&_h2]:uppercase [&_h2]:tracking-tight [&_h2]:leading-[0.95] [&_h2]:text-[clamp(1.375rem,3vw,2rem)] [&_h2]:text-ink",
    "[&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-ink",
    "[&_a]:text-accent [&_a]:underline [&_a]:decoration-ink/25 [&_a]:underline-offset-4 hover:[&_a]:decoration-accent",
    "[&_strong]:font-semibold [&_strong]:text-ink",
    "[&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:pl-5 [&_li]:list-disc [&_li]:marker:text-accent",
    "[&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-6 [&_blockquote]:text-ink",
    className,
  ]}
  style="max-inline-size:65ch"
>
  <slot />
</div>
